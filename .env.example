# Supabase project URL and anon/publishable key.
# Dashboard -> Project Settings -> API Keys
#
# Both are safe to ship to the browser: the anon key grants no privileges by
# itself, and every query it makes is still filtered by the row level security
# policies in supabase/schema.sql.
#
# This project intentionally never uses the service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
